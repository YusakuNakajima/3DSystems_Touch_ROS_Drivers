<?xml version="1.0" encoding="utf-8"?>
<robot name="phantom_touch" xmlns:xacro="http://www.ros.org/wiki/xacro">
	
	<!-- Materials -->
	<material name="metal_seamed">
		<color rgba="0.4627450980392157 0.4666666666666667 0.4509803921568628 1.0" />
	</material>
	<material name="blue">
		<color rgba="0.0 0.0 0.8 1.0" />
	</material>
	<material name="white">
		<color rgba="1.0 1.0 1.0 1.0" />
	</material>

  <!-- World -->
  <link name="world" />

  <joint name="world_to_base" type="fixed">
    <parent link="world" />
    <child link="touch_base" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
	
	<!-- Links -->
  <link name="touch_base" >
    <visual>
			<origin xyz="0 -0.02 0" />
      <geometry>
				<mesh filename="package://touch_description/meshes/base.stl" />
      </geometry>
      <material name="metal_seamed"/>
    </visual>
  </link>
  <link name="touch_torso" >
    <visual>
			<origin xyz="0 0 0.036" rpy="-1.5707 0 0"/>
      <geometry>
				<mesh filename="package://touch_description/meshes/torso.stl" />
      </geometry>
      <material name="blue"/>
    </visual>
  </link>
  <link name="touch_upper_arm" >
		<visual>
			<origin xyz="0.0075 0 0" rpy="0 0 0"/>
      <geometry>
				<mesh filename="package://touch_description/meshes/upper_arm.stl" />
      </geometry>
      <material name="metal_seamed" />
    </visual>
  </link>
  <link name="touch_lower_arm" >
		<visual>
			<origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
				<mesh filename="package://touch_description/meshes/lower_arm.stl" />
      </geometry>
      <material name="metal_seamed" />
    </visual>
  </link>
  <link name="touch_wrist" >
		<visual>
			<origin xyz="0 0 0" rpy="3.14159 0 0"/>
      <geometry>
				<mesh filename="package://touch_description/meshes/wrist.stl" />
      </geometry>
      <material name="metal_seamed" />
    </visual>
  </link>
  <link name="touch_tip" >
		<visual>
			<origin xyz="0 0 0" rpy="-1.5707 0 0"/>
      <geometry>
				<mesh filename="package://touch_description/meshes/tip.stl" />
      </geometry>
      <material name="metal_seamed" />
    </visual>
  </link>
  <link name="touch_stylus" >
    <visual>
			<origin xyz="0 -0.033 0" rpy="1.5707 1.5707 0"/>
      <geometry>
				<mesh filename="package://touch_description/meshes/pen.stl" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>
  
  <!-- New touch_force link -->
  <link name="touch_force">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>
  
	<!-- joints -->
  <joint name="waist" type="revolute" >
    <parent link="touch_base" />
    <child link="touch_torso" />
    <origin xyz="0 0 0.09" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.98" upper="0.98" velocity="100" effort="5" />
  </joint>
  <joint name="shoulder" type="revolute" >
    <parent link="touch_torso" />
    <child link="touch_upper_arm" />
    <origin xyz="-0.0075 0 0.035" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="1.75" velocity="100" effort="5" />
  </joint>
  <joint name="elbow" type="revolute" >
    <parent link="touch_upper_arm" />
    <child link="touch_lower_arm" />
    <origin xyz="0.0075 .134 0" rpy="-1.5 0 0" />
    <axis xyz="1 0 0" />
		<!-- upper="1.25" -->
    <limit lower="-0.81" upper="1.25" velocity="100" effort="5" /> 
  </joint>
  <joint name="yaw" type="revolute" >
    <parent link="touch_lower_arm" />
    <child link="touch_wrist" />
    <origin xyz="0 0.08 0" />
    <axis xyz="0 1 0" />
    <limit lower="3.92" upper="8.83" velocity="100" effort="5" />
  </joint>
  <joint name="pitch" type="revolute" >
    <parent link="touch_wrist" />
    <child link="touch_tip" />
    <origin xyz="0 0.0525 0" rpy="0.5 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-0.5" upper="1.75" velocity="100" effort="5" />
  </joint>
  <joint name="roll" type="revolute" >
    <parent link="touch_tip" />
    <child link="touch_stylus" />
    <origin xyz="0 -0.023 0" rpy="3.14159 3.14159 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.58" upper="2.58" velocity="100" effort="5" />
  </joint>
  <joint name="touch_tip_to_touch_force" type="fixed">
    <parent link="touch_base"/>
    <child link="touch_force"/>
    <origin xyz="0 0.1 0.3" rpy="0 0 3.14159"/>
		  </joint>
</robot>
