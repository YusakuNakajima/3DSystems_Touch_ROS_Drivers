<launch>
  <arg name="reference_frame" default="/map"/>
  <arg name="units" default="mm"/>
  <arg name="publish_rate" default="1000"/>
  <arg name="prefix" default="phantom"/>
  <arg name="device_name" default="Default Device"/>
  
  <group ns="$(arg prefix)">
    <node name="omni_state" pkg="omni_common" type="omni_state" output="screen">
      <param name="device_name" value="$(arg device_name)"/>
      <param name="omni_name" value="phantom"/>
      <param name="publish_rate" value="$(arg publish_rate)"/>
      <param name="reference_frame" value="$(arg reference_frame)"/>
      <param name="units" value="$(arg units)"/>
    </node>

    <param name="$(arg prefix)_robot_description" command="cat $(find omni_description)/urdf/omni.urdf" />
    <node name="$(arg prefix)_robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
        <!--<remap from="joint_states" to="$(arg prefix)/joint_states" />-->
        <remap from="robot_description" to="$(arg prefix)_robot_description" />
    </node>
  </group>
</launch>
